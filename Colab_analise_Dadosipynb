        "# Colunas numéricas para analisar\n",
        "numerical_cols = ['capitulo', 'versiculo', 'tempo']\n",
        "\n",
        "for col in numerical_cols:\n",
        "    # Cálculo do IQR (Intervalo Interquartil)\n",
        "    Q1 = df[col].quantile(0.25)\n",
        "    Q3 = df[col].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "\n",
        "    # Definindo limites\n",
        "    lower_bound = Q1 - 1.5 * IQR\n",
        "    upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "    # Contando outliers\n",
        "    num_outliers = df[(df[col] < lower_bound) | (df[col] > upper_bound)].shape[0]\n",
        "    percentage = (num_outliers / df.shape[0]) * 100\n",
        "\n",
        "    print(f\"Coluna '{col}': {num_outliers} outliers encontrados ({percentage:.2f}%)\")\n",
        "\n",
        "# Gerar gráfico Boxplot para visualizar os outliers\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.boxplot(data=df[numerical_cols])\n",
        "plt.title('Boxplot para Identificação de Outliers')\n",
